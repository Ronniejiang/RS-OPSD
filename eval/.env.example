# Copy the values needed by your benchmark run into the shell environment.
API_BASE=http://127.0.0.1:8000/v1
OPENAI_MODEL_ID=your-served-model-name
BENCHMARK=lrs-vqa,mme-realworld-rs,xlrs-bench

LRS_ROOT=/path/to/LRS-VQA
MME_ROOT=/path/to/MME-RealWorld
XLRS_ROOT=/path/to/XLRS-Bench

OUT_ROOT=eval/results
RUN_NAME=baseline
PARALLEL_WORKERS=32
MAX_TOKENS=4096
MAX_PIXELS=16777216
IMAGE_FORMAT=png
ENABLE_THINKING=False
RESUME=0

# Optional LRS-VQA tolerant metric. The model must already exist locally.
LRS_SEMANTIC_MODEL=/path/to/bge-base-en-v1.5
LRS_SEMANTIC_THRESHOLD=0.85

# Needed only by scripts/run_local_vllm.sh.
MODEL_PATH=/path/to/huggingface-model
